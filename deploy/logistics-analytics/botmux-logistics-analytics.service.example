[Unit]
Description=BotMux logistics conversation analytics
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/botmux
Environment=SESSION_DATA_DIR=%h/.botmux/data
Environment=BOTMUX_ANALYTICS_HOST=127.0.0.1
Environment=BOTMUX_ANALYTICS_PORT=17870
EnvironmentFile=-%h/.botmux/analytics.env
ExecStart=%h/projects/botmux/deploy/logistics-analytics/start.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=%h/.botmux/data
ReadWritePaths=%h/.botmux/logs

[Install]
WantedBy=default.target
